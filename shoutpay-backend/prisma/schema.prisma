generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
}

enum DeviceActiveStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  RECEIVED
  SENT
  REFUND
  FAILED
  PENDING
}

enum TransactionStatus {
  SUCCESS
  FAILED
  PENDING
}

enum SubscriptionPlan {
  FREE_TRIAL
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  FREE_TRIAL
  ACTIVE
  EXPIRED
}

model Merchant {
  id          String         @id @default(cuid())
  merchantId  String         @unique
  firebaseUid String?        @unique
  ownerName   String
  shopName    String
  phoneNumber String
  status      MerchantStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  devices       Device[]
  transactions  Transaction[]
  subscriptions Subscription[]
  authSessions  AuthSession[]

  @@map("merchants")
}

model Device {
  id             String             @id @default(cuid())
  deviceId       String             @unique
  merchantId     String
  deviceName     String?
  androidVersion String?
  lastSyncTime   DateTime?
  activeStatus   DeviceActiveStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  authSessions AuthSession[]

  @@index([merchantId])
  @@map("devices")
}

model AuthSession {
  id            String         @id @default(cuid())
  merchantId    String
  deviceId      String
  tokenFamilyId String
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([merchantId])
  @@index([deviceId])
  @@index([tokenFamilyId])
  @@map("auth_sessions")
}

model RefreshToken {
  id            String      @id @default(cuid())
  sessionId     String
  tokenFamilyId String
  tokenHash     String      @unique
  issuedAt      DateTime    @default(now())
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())

  session       AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tokenFamilyId])
  @@map("refresh_tokens")
}

model Transaction {
  id              String   @id @default(cuid())
  transactionUuid String   @unique
  merchantId      String
  deviceId        String
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("INR")
  senderName      String
  senderVpa       String?
  upiReference    String?
  upiApp          String?
  transactionTime DateTime
  status          String   @default("SUCCESS")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Legacy fields preserved for backward compatibility (pre Phase 6)
  transactionId   String?
  referenceId     String?
  type            TransactionType? @default(RECEIVED)
  dedupFingerprint String?
  createdAtDevice DateTime?
  syncedAt        DateTime? @default(now())
  deletedAt       DateTime?
  rawNotification String?
  parserVersion   String?
  parseStatus     String?
  sourceType      String?
  packageName     String?
  notificationKey String?
  originalNotificationText String?
  cleanedNotificationText String?

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@index([merchantId, transactionTime])
  @@index([upiReference])
  @@index([transactionUuid])
  @@map("transactions")
}

model Subscription {
  id         String             @id @default(cuid())
  merchantId String
  plan       SubscriptionPlan
  status     SubscriptionStatus
  startDate  DateTime
  endDate    DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@index([merchantId, status])
  @@map("subscriptions")
}
