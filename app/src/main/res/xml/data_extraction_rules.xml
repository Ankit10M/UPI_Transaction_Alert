<?xml version="1.0" encoding="utf-8"?>
<!-- CLAUDE.md Section 7.6: financial transaction data is excluded from Android auto-backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>