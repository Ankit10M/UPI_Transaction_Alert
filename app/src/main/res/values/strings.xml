    <string name="onboarding_title">ShoutPay</string>
    <string name="onboarding_subtitle">Listen to your payments</string>
    <string name="onboarding_body">ShoutPay listens for successful payment notifications from Google Pay, PhonePe, Paytm, and BHIM, and announces them out loud — no need to look at your phone.\n\nEverything runs fully offline. Your data never leaves your device.</string>
    <string name="onboarding_continue">Accept &amp; Continue</string>

    <string name="privacy_title">Privacy explanation</string>
    <string name="privacy_body">ShoutPay only reads notifications from Google Pay, PhonePe, Paytm, and BHIM to detect payment confirmations. It ignores and does not store notifications from any other app. All data stays on your device — no account, no internet, no sharing.</string>

    <string name="permission_title">Set up permissions</string>
